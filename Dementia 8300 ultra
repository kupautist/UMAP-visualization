
<!DOCTYPE html>
<html>
<head>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
            padding: 20px;
        }
        h1 {
            text-align: center;
            color: #333;
            font-size: 2em;
            text-transform: uppercase;
        }

        h2 {
            color: #FF69B4;
            font-style: italic;
            font-size: 1.5em;
            text-align: center;
        }
        form {
            margin: 20px auto;
            padding: 10px;
            width: 80%;
            max-width: 300px;
            border: 1px solid #ccc;
            border-radius: 5px;
            background-color: #FFFFE0;
        }

        .button:hover {
            background-color: #FF1493
        }
        .button {
            display: inline-block;
            width: 50%;
            padding: 10px;
            background-color: #FFC0CB;
            color: #fff;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 16px;
            margin-top: 10px;
        }
        .button-container {
            text-align: center;
        }
        div {
            margin: 10px;

        }
        input[type="checkbox"], input[type="radio"] {
            cursor: pointer;
        }

        input[type="text"], input[type="password"] {
            margin: 5px

        }

        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            h1 {
                font-size: 1.8em;
            }

            h2 {
                font-size: 1.3em;
            }

        }

        @media (max-width: 480px) {
            h1 {
                font-size: 1.5em;
            }

            h2 {
                font-size: 1.2em;
            }

            input[type="text"], input[type="password"] {
                font-size: 14px;
            }
        }
    </style>
<title>HTML, CSS and JavaScript demo</title>
</head>
<body>
<div class="container">
<h1>My form</h1>
<h2>Welcome to the Test Page</h2>
<form>
    <div>Username: <input type="text">
    <br>
    Password: <input type="password"> </div>

    <div><input type="checkbox" name="remember" checked> Remember me</div>

    <div><input type="radio" name="options" value="option1"> Option 1
    <input type="radio" name="options" value="option2"> Option 2</div>
    <div class="button-container">
    <input class="button" type="submit" value="Submit">
    </div>
</form>
</div>
</body>
</html>
